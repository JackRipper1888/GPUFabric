flowchart TD
    C["创建 T1/T2"] --> T["technical_fetching"]
    T --> CHECK["校验报告/快照 Hash、配置 Hash、Benchmark 分级"]
    CHECK --> V["technical_verified"]
    V --> EP["evidence_pending"]
    EP --> ES["获取材料要求和直传凭据"]
    ES --> PUT["浏览器直传对象存储"]
    PUT --> SCAN["scanner Hash/MIME/病毒校验"]
    SCAN --> REVIEW["evidence_reviewing"]
    REVIEW -->|缺材料或不通过| CHANGE["changes_requested"]
    CHANGE --> EP
    REVIEW -->|asset.lifecycle verified| CONDITION["保存结构化 assetCondition + evidenceId"]
    CONDITION -->|全部材料 verified| READY["ready_for_valuation"]
    READY --> MARKET["市场样本 pending -> 独立 verified -> 不可变快照"]
    MARKET --> GATE["配置全字段/Hash一致 + 成色一致 + 3样本/2来源"]
    GATE -->|通过| VAL["valuating"]
    GATE -->|不通过| BLOCKED["拒绝估值 / 等待数据或材料"]
    VAL --> VR["valuation_ready"]
    VR --> RR["review_pending / reviewing"]
    RR -->|补充修改| CHANGE
    RR -->|通过| APPROVED["approved"]
    APPROVED --> ISSUING["issuing"]
    ISSUING --> ISSUED["issued，可下载"]
    ISSUED --> REVOKED["revoked"]
    ISSUED --> EXPIRED["expired"]
    CHECK -->|技术不可信或证据缺类| REJECT["technical_rejected / rejected"]
    VAL -->|处理失败| FAIL["failed"]
